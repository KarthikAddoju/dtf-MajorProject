{
  "name": "contracts",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "compile": "HOME=$PWD npx hardhat compile",
    "devnet:start": "node scripts/devnet-start.mjs",
    "devnet:reset": "node scripts/devnet-reset.mjs",
    "deploy": "HOME=$PWD npx hardhat run scripts/deploy.ts",
    "deploy:local": "HOME=$PWD npx hardhat run scripts/deploy.ts --network localhost",
    "sync:env": "node scripts/sync-env.mjs",
    "deploy:sync": "npm run deploy:local && npm run sync:env",
    "test:mint": "HOME=$PWD npx hardhat run scripts/testMint.ts --network localhost",
    "test": "HOME=$PWD npx hardhat test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/node": "^22.19.11",
    "hardhat": "^2.22.1",
    "solc": "0.8.26",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.4.0"
  }
}
