FROM node:20-alpine AS builder

WORKDIR /app

# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat

ARG NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
ARG NEXT_PUBLIC_CHAIN_ID=31337
ARG NEXT_PUBLIC_POCT_ADDRESS=0x0000000000000000000000000000000000000001
ARG NEXT_PUBLIC_EDU_ADDRESS=0x0000000000000000000000000000000000000002
ARG NEXT_PUBLIC_MINT_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000003

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_POCT_ADDRESS=$NEXT_PUBLIC_POCT_ADDRESS
ENV NEXT_PUBLIC_EDU_ADDRESS=$NEXT_PUBLIC_EDU_ADDRESS
ENV NEXT_PUBLIC_MINT_CONTROLLER_ADDRESS=$NEXT_PUBLIC_MINT_CONTROLLER_ADDRESS

# Install dependencies based on the preferred package manager
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code and build
COPY . .

# Set environment variable to skip ESLint and Typecheck in Docker build if you prefer, or let it check
# We let it check
RUN npm run build

# Production image, copy all the files and run next
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
ARG NEXT_PUBLIC_CHAIN_ID=31337
ARG NEXT_PUBLIC_POCT_ADDRESS=0x0000000000000000000000000000000000000001
ARG NEXT_PUBLIC_EDU_ADDRESS=0x0000000000000000000000000000000000000002
ARG NEXT_PUBLIC_MINT_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000003

ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_POCT_ADDRESS=$NEXT_PUBLIC_POCT_ADDRESS
ENV NEXT_PUBLIC_EDU_ADDRESS=$NEXT_PUBLIC_EDU_ADDRESS
ENV NEXT_PUBLIC_MINT_CONTROLLER_ADDRESS=$NEXT_PUBLIC_MINT_CONTROLLER_ADDRESS

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000

CMD ["node", "server.js"]
